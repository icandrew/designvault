# Design Vault configuration
# Copy this file to `.env.local` and change values if you need to.
# Every setting is optional — the defaults work out of the box.

# Where the database (vault.db) and screenshots (storage/) are kept.
# Relative paths are resolved from the project folder.
DESIGN_VAULT_DATA_DIR=data

# Fixed read-only API key for AI agents. Leave empty to use the key generated
# automatically on first run (shown in Settings → Agent access).
DESIGN_VAULT_API_KEY=

# Maximum upload size per screenshot, in megabytes.
DESIGN_VAULT_MAX_UPLOAD_MB=25

# Maximum MP4 video size, in megabytes.
DESIGN_VAULT_MAX_VIDEO_MB=200

# How long URL capture waits for a page to load, in milliseconds.
DESIGN_VAULT_CAPTURE_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# Online vault (Vercel). Leave these empty to use the local data folder.
# See docs/DEPLOY-VERCEL.md. On Vercel, Blob and Turso fill these in for you.
# ---------------------------------------------------------------------------

# Login password. Required on Vercel (the site stays locked without it).
# Optional locally: set it to require signing in on this computer too.
DESIGN_VAULT_PASSWORD=

# Optional: signs login sessions independently of the password.
DESIGN_VAULT_SESSION_SECRET=

# Hosted database (Turso / libSQL).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Hosted file storage (Vercel Blob, private store).
BLOB_READ_WRITE_TOKEN=

# Only for automated tests: allows capturing localhost/private addresses.
# Never enable this on a machine reachable from a network.
DESIGN_VAULT_CAPTURE_ALLOW_PRIVATE=false
